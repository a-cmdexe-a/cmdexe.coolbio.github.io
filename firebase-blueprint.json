{
  "entities": {
    "message": {
      "title": "Feedback Message",
      "description": "An anonymous message from a user.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The feedback message text.",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent."
        }
      },
      "required": ["text", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "message",
      "description": "Collection of anonymous messages."
    }
  }
}
